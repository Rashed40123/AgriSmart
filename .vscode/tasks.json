{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "mvn-javafx-run",
            "type": "shell",
            "command": "mvn clean compile javafx:run",
            "problemMatcher": ["$maven"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}
